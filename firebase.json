{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "location": "asia-south1"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Vaishnavi Bupara Casting",
        "supportEmail": "sreedrisyamedia1@gmail.com",
        "authorizedRedirectUris": [
          "https://vaishnavi-bupara-casting.firebaseapp.com/__/auth/handler",
          "https://vaishnavi-bupara-casting.web.app/__/auth/handler",
          "http://localhost:5173"
        ]
      }
    }
  }
}
